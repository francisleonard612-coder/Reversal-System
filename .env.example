# Copy to .env for local runs; on Railway set these as service variables.
# Everything not listed here lives in config/settings.yaml.

# --- Deriv -------------------------------------------------------------
DERIV_API_TOKEN=            # Read + Trade scopes only
DERIV_APP_ID=1089           # public demo id; register your own for live
# DERIV_AUTH_MODE=otp       # or "legacy"
# DERIV_ACCOUNT_ID=         # auto-resolved (demo/real) if unset

# --- Mode: two switches that must agree ----------------------------------
TRADING_MODE=research       # research (never buys) | demo | live
DERIV_USE_REAL=false        # true ONLY with TRADING_MODE=live

# --- Storage -------------------------------------------------------------
DB_BACKEND=sqlite           # postgres on Railway -- sqlite is wiped every redeploy
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Universe & contract -------------------------------------------------
SYMBOLS=R_100,R_75,R_50,R_25,R_10
# Must equal contract.duration_bars_approx x candle size (default 5 x 60s),
# or startup refuses: backtests/labels would measure a different bet.
# CONTRACT_DURATION=5
# CONTRACT_DURATION_UNIT=m

# --- Risk ----------------------------------------------------------------
BASE_STAKE=1.0
MAX_STAKE=5.0
MAX_DAILY_LOSS=25.0
MAX_DRAWDOWN=50.0
MAX_CONSECUTIVE_LOSSES=8
# MAX_TRADES_PER_DAY=100
# COOLDOWN_SECONDS=0
STAKING_METHOD=fixed        # fixed | percentage | kelly (kelly needs Level 2)
                            # martingale can only be enabled in settings.yaml

# --- MC-calibrated expiry (strategy/expiry.py) -----------------------------
EXPIRY_CALIBRATION=true
# EXPIRY_HORIZONS=3t,5t,7t,10t,1m,2m,3m,5m
# EXPIRY_MIN_SAMPLES=200
EXPIRY_REQUIRE_EDGE=true    # demo only: false keeps trading while evidence builds

# --- Level 2 (calibrated probability model) -------------------------------
LEVEL2_ENABLED=false        # only has effect once `--train` saved a PROMOTED model
# LEVEL2_MODEL_PATH=data/level2_model.json
# LEVEL2_MIN_EV=0.0

LOG_LEVEL=INFO
