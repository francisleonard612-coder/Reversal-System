# Copy these into Railway -> this service -> Variables. Never commit real values.

# --- Deriv (required) ---
DERIV_APP_ID=
DERIV_API_TOKEN=
# "demo" (default) or "real". Keep demo until the trade log shows a real edge.
DERIV_ACCOUNT_TYPE=demo
DERIV_ACCOUNT_ID=

# --- Supabase persistence (required; REST URL + service_role key) ---
# Run the SQL in README.md once first. Tables are named bot_* so they do not
# collide with Reversal-System's or ER's tables in the same project.
SUPABASE_URL=
SUPABASE_KEY=

# --- What to trade ---
# Comma-separated. Empty = automatic (all R_ indices + top-3 1HZ).
SYMBOLS=
CANDIDATE_DURATIONS_MINUTES=1,2,3,5,10

# --- Staking ---
FIXED_STAKE=0.35          # every trade stakes this; 0 = original dynamic sizing
MARTINGALE_MAX_STEPS=0    # 0 = no recovery staking (recommended)

# --- Filters (defaults = original values; loosen to trade more) ---
MIN_EXP_WIN_RATE=0.505    # Monte Carlo expected win rate floor
MIN_LAYER_AGREE=9         # Gate 1: layers that must agree
MAX_LAYER_DISAGREE=4      # Gate 1: layers allowed to disagree
PE_THRESHOLD=0.85         # Gate 2: permutation-entropy ceiling (higher = looser)
MIN_TF_AGREEMENT=2        # Gate 3: timeframes (of 3) that must agree
BOOTSTRAP_AGREE_TOL=0.08  # Gate 4: allowed gap between bootstrap and MC
CONVICTION_FLOOR=0.20     # regime filter: minimum conviction to trade
REGIME_ROUTING=true       # false = skip the regime filter entirely
MINIMAL_FILTER_MODE=false # true = skip Gates 1 and 4
